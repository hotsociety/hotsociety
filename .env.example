NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_CHECKOUT_MENSAL=
NEXT_PUBLIC_CHECKOUT_ANUAL=

# Só no servidor (Vercel). Nunca use NEXT_PUBLIC_ nestas duas.
SUPABASE_SERVICE_ROLE_KEY=
VENDAS_WEBHOOK_TOKEN=

# Captcha do login (o mesmo ligado no Supabase). turnstile ou hcaptcha
NEXT_PUBLIC_CAPTCHA_PROVIDER=turnstile
NEXT_PUBLIC_CAPTCHA_SITE_KEY=

# Pix pela Transfeer (só servidor, tipo Secret na Vercel)
TRANSFEER_API_KEY=
TRANSFEER_WEBHOOK_SECRET=
# Opcional: recibo por e-mail (Resend)
RESEND_API_KEY=
EMAIL_REMETENTE=HOT SOCIETY <nao-responda@hotsociety.com.br>

# Appmax (loja HOT SOCIETY · Appmax → API → Credenciais). Só vira o gateway com GATEWAY_ATIVO=appmax.
GATEWAY_ATIVO=
APPMAX_CLIENT_ID=
APPMAX_CLIENT_SECRET=
APPMAX_EXTERNAL_ID=
# Opcionais: sandbox | (vazio = produção), máximo de parcelas sem juros (1 a 12) e secret do webhook.
APPMAX_AMBIENTE=
APPMAX_PARCELAS_MAX=
APPMAX_WEBHOOK_SECRET=
